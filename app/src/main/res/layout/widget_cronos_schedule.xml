<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_background"
    android:padding="14dp">

    <!-- Header: App Name / Icon + Today's Date + Refresh Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_widget_school"
            android:contentDescription="Cronos"
            android:tint="#818CF8" />

        <TextView
            android:id="@+id/widget_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Cronos"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_date_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Quarta, 30 Set"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Refresh Button -->
        <ImageButton
            android:id="@+id/widget_btn_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_refresh_button_bg"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="Atualizar Widget"
            android:scaleType="centerInside"
            android:tint="#CBD5E1" />
    </LinearLayout>

    <!-- Main Content Area: Status Badge + Subject Title + Location/Teacher + Countdown Info -->
    <LinearLayout
        android:id="@+id/widget_content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp">

        <!-- Status Pill Badge (e.g. 🟢 AULA EM ANDAMENTO or ⏳ PRÓXIMA AULA) -->
        <LinearLayout
            android:id="@+id/widget_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_badge_background_ongoing"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/widget_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 AULA EM ANDAMENTO"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Subject Name & Code -->
        <TextView
            android:id="@+id/widget_subject_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Cálculo Diferencial I"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Room, Building & Teacher -->
        <TextView
            android:id="@+id/widget_details_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="📍 Sala 102 • Bloco B • Prof. Marcos"
            android:textColor="#CBD5E1"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Time & Countdown / Info (e.g. "🕒 08:00 - 09:40 • Termina em 35 min" or "Começa em 20 min") -->
        <TextView
            android:id="@+id/widget_time_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="🕒 08:00 - 09:40 (Termina em 35 min)"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Bottom Footer Bar: Today's remaining classes + Tasks count + Quick launch button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/widget_footer_classes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📅 3 aulas hoje"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_footer_tasks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📝 2 tarefas"
            android:textColor="#A78BFA"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/widget_footer_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Abrir ↗"
            android:textColor="#818CF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/widget_chip_background"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>
</LinearLayout>
